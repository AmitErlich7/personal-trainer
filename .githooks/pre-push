#!/bin/sh
# Refuse pushes to main. All changes reach main through a reviewed pull request.
# See GIT-WORKFLOW.md.

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push to main blocked. Push a branch and open a pull request instead (see GIT-WORKFLOW.md)." >&2
    exit 1
  fi
done

exit 0
